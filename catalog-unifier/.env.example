# Catalog Unifier MVP
CATALOG_UNIFIER_DB_PATH=./catalog-unifier/storage/unifier.db
CATALOG_UNIFIER_OUTPUT_DIR=./catalog-unifier/output
UNIFIER_DB_KEEP_RUNS=5
UNIFIER_OUTPUT_KEEP_RUNS=5
UNIFIER_STORE_RAW_STAGING=0
UNIFIER_STORE_RAW_UNIFIED_SOURCES=0
UNIFIER_STORE_UNIFIED_ATTRIBUTES_JSON=1
UNIFIER_DB_VACUUM_ON_PRUNE=1
UNIFIER_EXPORT_JSON=1
UNIFIER_EXPORT_CSV=1
UNIFIER_EXPORT_PRETTY_JSON=0
UNIFIER_EXPORT_INCLUDE_RAW_JSON=0

# Provider: MegaSur
MEGASUR_LOCAL_PATH=./storage/megasur/current.json
MEGASUR_FEED_URL=

# Provider: DMI (optional in MVP)
DMI_LOCAL_PATH=
DMI_API_URL=
DMI_USERNAME=
DMI_PASSWORD=
DMI_CACHE_PATH=./catalog-unifier/storage/dmi-current.json
DMI_CACHE_MAX_AGE_MINUTES=60

# Pricing model
UNIFIER_DEFAULT_MARGIN_PERCENT=20
UNIFIER_WEEKLY_MARGIN_PERCENT=10
UNIFIER_SHIPPING_FEE_EUR=5

# WooCommerce publish control (second block)
UNIFIER_WC_URL=
UNIFIER_WC_CONSUMER_KEY=
UNIFIER_WC_CONSUMER_SECRET=
UNIFIER_WC_TIMEOUT_MS=30000
UNIFIER_WC_CREATE_CATEGORIES=1
