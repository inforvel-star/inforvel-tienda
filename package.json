{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "qa:security:dev": "bash scripts/security-regression.sh https://dev.inforvel.online",
    "qa:smoke:dev": "bash scripts/smoke-dev.sh https://dev.inforvel.online",
    "qa:gate:dev": "bash scripts/predeploy-dev-gate.sh https://dev.inforvel.online",
    "audit:product-accents": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/audit-product-accent-errors.ts",
    "audit:stale-prices": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/audit-stale-prices.ts",
    "test:pricing": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-pricing.ts",
    "dryrun:pricing": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/dry-run-pricing.ts",
    "megasur:sync": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/megasur-wc-sync.ts",
    "backfill:clean-descriptions": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/backfill-clean-descriptions.ts",
    "offers:weekly": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/weekly-fake-offers.ts",
    "offers:weekly:dry": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/weekly-fake-offers.ts --dry-run",
    "offers:weekly:force": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/weekly-fake-offers.ts --force-apply",
    "blog:autopublish": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/blog-autopublish.ts",
    "blog:autopublish:daily": "bash scripts/blog-autopublish-daily.sh",
    "blog:autopublish:dry": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/blog-autopublish.ts --dry-run",
    "catalog:unifier:mvp": "node catalog-unifier/src/cli.js run --source=all --dry-run",
    "catalog:unifier:mvp:apply": "node catalog-unifier/src/cli.js run --source=all --apply",
    "catalog:unifier:bootstrap:wp": "node catalog-unifier/src/tools/bootstrap-wp-env.js",
    "catalog:unifier:simulate": "node catalog-unifier/src/cli.js run --source=all --dry-run --publish=simulate --publish-limit=200",
    "catalog:unifier:publish": "node catalog-unifier/src/cli.js run --source=all --apply --publish=apply --publish-limit=200",
    "catalog:unifier:cron:run": "bash scripts/catalog-unifier-scheduled.sh",
    "catalog:unifier:health:48h": "bash scripts/catalog-unifier-health-report.sh 48",
    "catalog:unifier:cron:install": "bash scripts/install-catalog-unifier-cron.sh"
  },
